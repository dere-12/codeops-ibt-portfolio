@baseUrl = http://localhost:3000/api/v1

### Get all orders with default pagination
GET {{baseUrl}}/orders

### Filter orders by status and area
GET {{baseUrl}}/orders?status=PENDING&area=Bole

### Get the first page of five orders
GET {{baseUrl}}/orders?limit=5&offset=0

### Get the second page of five orders, sorted by area
GET {{baseUrl}}/orders?limit=5&offset=5&sort=area

### Invalid limit should return 400
GET {{baseUrl}}/orders?limit=999

### Get pending orders
GET {{baseUrl}}/orders?status=PENDING

### Get orders belonging to restaurant 1
GET {{baseUrl}}/restaurants/1/orders

### A missing parent restaurant should return 404
GET {{baseUrl}}/restaurants/99/orders

### Valid transition: PENDING -> PREPARING (expected 200)
PATCH {{baseUrl}}/orders/2/status
Content-Type: application/json

{
  "status": "PREPARING"
}

### Invalid status value should return 400
PATCH {{baseUrl}}/orders/1/status
Content-Type: application/json

{
  "status": "PLAYING"
}

### Invalid transition: DELIVERED -> PENDING (expected 409)
PATCH {{baseUrl}}/orders/4/status
Content-Type: application/json

{
  "status": "PENDING"
}

### Delete an existing order (expected 204)
DELETE {{baseUrl}}/orders/14

### Delete a missing order (expected 404)
DELETE {{baseUrl}}/orders/999

### Filter by multiple statuses
GET {{baseUrl}}/orders?status=PENDING,PREPARING

### Sort orders by totalSantim descending
GET {{baseUrl}}/orders?sort=-totalSantim

### Sort orders by customer ascending
GET {{baseUrl}}/orders?sort=customer

### Delete the same order twice (both expected 204)
DELETE {{baseUrl}}/orders/14

### Second delete of order 14 (expected 204)
DELETE {{baseUrl}}/orders/14

### Create an order; the server calculates totalSantim
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customer": "Abel Kebede",
  "area": "Bole",
  "restaurantId": 1,
  "lines": [{ "dishId": 1, "quantity": 1 }]
}

### Day58 final checkpoint: invalid TeleBirr phone (expected 400)
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customer": "Abel Kebede",
  "area": "Bole",
  "restaurantId": 1,
  "lines": [{ "dishId": 1, "quantity": 1 }],
  "telebirrPhone": "0812345678"
}

### Day58 final checkpoint: unknown isAdmin on a write (expected 400)
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customer": "Abel Kebede",
  "area": "Bole",
  "restaurantId": 1,
  "lines": [{ "dishId": 1, "quantity": 1 }],
  "isAdmin": true
}

### Unknown query property is stripped (expected 200)
GET {{baseUrl}}/orders?unknownFilter=ignored